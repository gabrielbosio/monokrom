// Crates game

// Player can be moved in 4 directions
struct Player
  x: int
  y: int
end

// A crate will be highlighted when
// stepping on a spot
struct Crate
  x: int
  y: int
  highlight: bool
  alive: bool
end

// Spots are places where the crates
// must be put on
struct Spot
  x: int
  y: int
  alive: bool
end

// Used to represent level boundaries
struct Rect
  x0: int
  y0: int
  x1: int
  y1: int
end

// Contains all the information needed
// when playing a level.
// The goal is the number of crates
// the player has to put on the spots.
// best is the field that holds the
// current minimum steps required to
// achieve the goal.
struct Level
  player: Player
  crates: array[16] of Crate
  spots: array[16] of Spot
  bounds: Rect
  goal: int
  best: int
end

// Contains all the levels
// information and the current level
// being played with its current state
struct Game
  levels: array[16] of Level
  num_levels: int
  level: Level
  level_idx: int
  score: int
  steps: int
  finished: bool
end

// Main loop
fn main()
  game: Game
  load_game(ref game)
  load_level(ref game, 0)
  while true
    update(ref game)
    draw(ref game)
    flip()
  end
end

// Stores all the levels information
// from the map cells. All cells that
// contain movable entities or
// entities that can be overlapped
// (e.g. A crate on a spot) are stored
// in the Game instance and removed
// from the map. The drawing logic
// will handle those entities as
// sprites instead of map cells.
fn load_game(game: ref Game)
  // Set level boundaries
  load_bounds(game)
  // Change this value if you want to
  // add or remove a level
  game.num_levels = 3
  for i in 0..game.num_levels
    level = ref game.levels[i]
    bounds = ref level.bounds
    crate_idx = 0
    goal_idx = 0
    for j in bounds.x0..bounds.x1
      for k in bounds.y0..bounds.y1
        m = mget(j, k)
        // Player
        if m == 1
          player = ref level.player
          player.x = j * 8
          player.y = k * 8
          mset(j, k, 0)
        // Crate
        else if m == 2
          crate = ref level.crates[crate_idx]
          crate.x = j * 8
          crate.y = k * 8
          crate.alive = true
          crate_idx = crate_idx + 1
          mset(j, k, 0)
        // Spot
        else if m == 4
          goal = ref level.spots[goal_idx]
          goal.x = j * 8
          goal.y = k * 8
          goal.alive = true
          goal_idx = goal_idx + 1
          mset(j, k, 0)
        // Crate on a spot
        else if m == 5
          crate = ref level.crates[crate_idx]
          crate.x = j * 8
          crate.y = k * 8
          crate.alive = true
          crate_idx = crate_idx + 1
          goal = ref level.spots[goal_idx]
          goal.x = j * 8
          goal.y = k * 8
          goal.alive = true
          goal_idx = goal_idx + 1
          mset(j, k, 0)
        end
        // We skipped the m == 3 path
        // because sprite 3 is the 
        // wall tile
      end
    end
    // Each time we added a spot into
    // the game, we increased goal_idx
    // by one
    level.goal = goal_idx
  end
end

// Loads each level boundaries.
// The bottom of the map editor shows
// the cursor position. This can serve
// as a guide to help you set the
// boundaries of a level.
fn load_bounds(game: ref Game)
  bounds = ref game.levels[0].bounds
  bounds.x0 = 0
  bounds.y0 = 0
  bounds.x1 = 7
  bounds.y1 = 5
  bounds = ref game.levels[1].bounds
  bounds.x0 = 7
  bounds.y0 = 0
  bounds.x1 = 26
  bounds.y1 = 11
  bounds = ref game.levels[2].bounds
  bounds.x0 = 0
  bounds.y0 = 11
  bounds.x1 = 17
  bounds.y1 = 27
end

// Loads the nth level as the current
// level to be updated and drawn 
// each game step
fn load_level(game: ref Game, n: int)
  game.level_idx = n
  game.steps = 0
  game.finished = false
  level = ref game.level
  src = ref game.levels[n]
  level.player = src.player
  level.bounds = src.bounds
  level.goal = src.goal
  level.best = src.best
  for i in 0..16
    level.crates[i] = src.crates[i]
    level.spots[i] = src.spots[i]
  end
end

// Update game step
fn update(game: ref Game)
  moved: bool
  
  // Only move the player when the
  // level is not completed
  if not game.finished
    // Try moving player left
    if btnp(0)
      moved = move_player(game, -8, 0)
    // Try moving player right
    else if btnp(1)
      moved = move_player(game, 8, 0)
    // Try moving player up
    else if btnp(2)
      moved = move_player(game, 0, -8)
    // Try moving player down
    else if btnp(3)
      moved = move_player(game, 0, 8)
    end
  end
  // Restart level
  if btnp(4)
    load_level(game, game.level_idx)
    return
  // Change level
  else if btnp(5)
    next = (game.level_idx + 1) % game.num_levels
    load_level(game, next)
  end
  
  // Only increment steps if the
  // player could be moved when
  // pressing one of the movement keys
  if moved
    game.steps = game.steps + 1
  end
  
  // Compute score each game step
  // after moving the player.
  // Check how many crates are placed
  // on a spot.
  game.score = 0
  for _, ref crate in game.level.crates
    if not crate.alive
      continue
    end
    crate.highlight = false
    for _, ref spot in game.level.spots
      if not spot.alive
        continue
      end
      // For each crate that is placed
      // on a spot, mark it as
      // highlighted and increase the
      // score
      if spot.x == crate.x and spot.y == crate.y
        crate.highlight = true
        game.score = game.score + 1
        break
      end
    end
  end
  // Condition for level completion
  if game.score == game.level.goal and (game.level.best == 0 or game.level.best > game.steps)
    game.level.best = game.steps
    game.levels[game.level_idx].best = game.level.best
    game.finished = true
  end
end

// Drawing logic
fn draw(game: ref Game)
  // Clear screen
  cls(0)
  
  // Draw level without its entities
  // (i.e. walls)
  bounds = ref game.level.bounds
  map(bounds.x0, bounds.y0, 0, 8, bounds.x1 - bounds.x0, bounds.y1 - bounds.y0)
  
  // Draw spots
  for _, ref spot in game.level.spots
    if spot.alive
      spr(4, spot.x - bounds.x0 * 8, spot.y - bounds.y0 * 8 + 8)
    end
  end
  // Draw crates. Sprite depends
  // wether the crate is highlighted
  // or not.
  for _, ref crate in game.level.crates
    if not crate.alive
      continue
    end
    s = 2
    if crate.highlight
      s = 5
    end
    spr(s, crate.x - bounds.x0 * 8, crate.y - bounds.y0 * 8 + 8)
  end
  // Draw player
  player = ref game.level.player
  spr(1, player.x - bounds.x0 * 8, player.y - bounds.y0 * 8 + 8)
  
  // Draw HUD
  color = 3
  if game.finished
    color = 2
  end
  draw_2_digits(game.score, 0, color)
  prints("/", 2 * 4, 0, color)
  draw_2_digits(game.level.goal, 2 * 4 + 4, color)
  draw_3_digits(game.steps, 2 * 4 + 4 + 3 * 4, color)
  prints("/", 2 * 4 + 4 + 3 * 4 + 3 * 4, 0, color)
  if game.level.best == 0
    prints("---", 2 * 4 + 4 + 3 * 4 + 2 * 4 + 2 * 4, 0, 3)
  else
    draw_3_digits(game.level.best, 2 * 4 + 4 + 3 * 4 + 2 * 4 + 2 * 4, color)
  end
  prints(" Z: RESET  X: NEXT", 2 * 4 + 4 + 3 * 4 + 2 * 4 + 2 * 4 + 4 * 4, 0, 2)
end

// Draw numbers that are bounded to
// 100
fn draw_2_digits(n: int, x: int, c: int)
  if n < 10
    printi(0, x, 0, c)
    printi(n, x + 4, 0, c)
  else
    printi(n, x, 0, c)
  end
end

// Draw numbers that are bounded to
// 1000
fn draw_3_digits(n: int, x: int, c: int)
  if n < 10
    prints("00", x, 0, c)
    printi(n, x + 2 * 4, 0, c)
  else if n < 100
    printi(0, x, 0, c)
    printi(n, x + 4, 0, c)
  else
    printi(n, x, 0, c)
  end
end

// Move player in a specific 
// velocity (dx, dy) if possible, this
// means, if the player destination
// is not blocked by a wall or a
// crate. If it blocked by a crate, 
// try moving it in the same velocity
// if possible (following the
// conditions specified in move_crate)
fn move_player(game: ref Game, dx: int, dy: int): bool
  player = ref game.level.player
  player.x = player.x + dx
  player.y = player.y + dy
  
  for _, ref crate in game.level.crates
    if player.x == crate.x and player.y == crate.y
      crate.x = crate.x + dx
      crate.y = crate.y + dy
      if not move_crate(game, crate, dx, dy)
        player.x = player.x - dx
        player.y = player.y - dy
        return false
      end
      break
    end
  end
  
  if mget(player.x / 8, player.y / 8) == 3
    player.x = player.x - dx
    player.y = player.y - dy
    return false
  end
  
  return true
end

// Move crate in a specific 
// velocity (dx, dy) if possible, this
// means, if the crate destination
// is not blocked by a wall or a
// crate.
fn move_crate(game: ref Game, target: ref Crate, dx: int, dy: int): bool
  for _, ref crate in game.level.crates
    if crate == target
      continue
    end
    if target.x == crate.x and target.y == crate.y
      target.x = target.x - dx
      target.y = target.y - dy
      return false
    end
  end
  if mget(target.x / 8, target.y / 8) == 3
    target.x = target.x - dx
    target.y = target.y - dy
    return false
  end
  return true
end

