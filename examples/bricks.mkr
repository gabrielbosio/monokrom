// Bricks game

// Player will only be moved
// horizontally
struct Player
  x: int
  y: int
  dx: int
end

// Each brick has its own position and
// they have a flag that is used to
// check wether they will be drawn on
// the screen or not
struct Brick
  x: int
  y: int
  dead: bool
end

// For better movement precision, the
// ball position and velocity are 
// stored as fixeds rather than
// integers
struct Ball
  x: fixed
  y: fixed
  dx: fixed
  dy: fixed
end

// The struct that containts anything
// related to the game and can be
// reset
struct Game
  player: Player
  ball: Ball
  bricks: array[64] of Brick
  num_bricks: int
  state: int
  balls: int
end

// Main loop
fn main()
  game: Game
  reset(ref game)
  
  while true
    update(ref game)
    draw(ref game)
    flip()
  end
end

// Resets the game, useful either when 
// starting or when restarting 
// because of a game won or because 
// the ball went out of the screen
fn reset(game: ref Game)
  // Set the player horizontally in
  // the center of the screen
  game.player.x = 72
  game.player.y = 136
  game.player.dx = 1
  
  // If the game resets because the 
  // ball went out of the screen then
  // we force the ball to stop
  game.ball.dx = 0.0
  game.ball.dy = 0.0
 
  // Given a fixed level we place the
  // bricks accordingly
  level: array[16] of int
  init_level(ref level)
  for i, row in level
    for j in 0..8
      // We initialize the level using
      // an array of ints where each
      // integer is a row and each bit
      // of an integer is a brick in a
      // row. Check the init_level
      // function for more details
      idx = row >> (7 - j)
      if (idx & 1) == 1
        new_brick = ref game.bricks[game.num_bricks]
        new_brick.x = j * 16 + 16
        new_brick.y = i * 8
        new_brick.dead = false
        // We set the counter that
        // will keep track of how many
        // bricks are left on screen
        game.num_bricks = game.num_bricks + 1
      end
    end
  end
  
  // If the game is starting we make
  // sure that the rest of the array
  // doesn't contain alive bricks
  for i in game.num_bricks..64
    game.bricks[i].dead = true
  end
  
  // We set the game state to the 
  // initial one, the update function
  // describes each state in detail
  game.state = 0
  // This counter gets track of how
  // many balls were used to finish
  // the game
  game.balls = 0
end

// Initializes the level to a fixed
// setup, each integer is a row and
// each bit of an integer is a brick
// in a row
fn init_level(level: ref array[16] of int)
  level[2] = 0b01111110
  level[3] = 0b11111111
  level[4] = 0b11111111
  level[5] = 0b01111110
end

// Updates a game frame
fn update(game: ref Game)
  player = ref game.player
  
  // Hold left or right key to move
  // the player
  if btn(0) and not btn(1) and player.x > 0
    player.x = player.x - player.dx
  else if btn(1) and not btn(0) and player.x < 144
    player.x = player.x + player.dx
  end
  
  ball = ref game.ball
  // Ball movement depends on game
  // state. State 0 is the initial one
  // so the game will allow us to
  // shoot the ball in the position
  // we want
  if game.state == 0
    // Press Z to shoot the ball
    if btnp(4)
      // We shoot the ball always to
      // the same direction
      ball.dx = 0.7
      ball.dy = -0.7
      // We change to playing state
      game.state = 1
      // Here we keep track of how
      // many balls we are using to
      // finish the game
      game.balls = game.balls + 1
      //play start sound
      sfx(0)
    end
    // We snap the ball to the player
    // position
    ball.x = itof(player.x + 8)
    ball.y = itof(player.y - 2)
  // The playing state makes the ball
  // to move freely through the screen
  // and bounce through bricks and the
  // player, Be careful to not make
  // the ball pass through the bottom
  // of the screen!
  else if game.state == 1
    // If the ball passes through the
    // bottom of the screen we go back
    // to the starting state
    if ball.y > 143.0
      game.state = 0
      sfx(4)
    end
    // We make the ball bounce through
    // the walls
    if ball.x < 1.0 or ball.x > 159.0
      ball.dx = -ball.dx
      sfx(3)
    end
    // We make the ball bounce through
    // the ceiling and the player
    in_ceiling = ball.y < 1.0
    if (in_ceiling or
        (ball.x >= itof(player.x) and
        ball.x <= itof(player.x + 16) and
        ball.y >= itof(player.y) and
        ball.y <= itof(player.y + 2)))
      ball.dy = -ball.dy
      if in_ceiling
        sfx(3)
      else
        sfx(2)
      end
    end
    // We make the ball bounce through
    // every brick and break them if
    // that happens.
    for _, ref brick in game.bricks
      if brick.dead
        continue
      end

      if (ball.x >= itof(brick.x) and
          ball.x <= itof(brick.x + 16) and
          ball.y >= itof(brick.y) and
          ball.y <= itof(brick.y + 8))
        ball.dy = -ball.dy
        brick.dead = true
        game.num_bricks = game.num_bricks - 1
        sfx(1)
        if game.num_bricks == 0
          game.state = 2
          sfx(5)
          return
        end
      end
    end
    
    // We only set the ball velocity 
    // in the lines above so we have
    // to apply velocity to the ball
    // position
    ball.x = ball.x + ball.dx
    ball.y = ball.y + ball.dy
  // State 2 is the finished state
  else if game.state == 2
    // Press Z to start over
    if btnp(4)
      reset(game)
    end
  end
end

// Draws a frame on the screen
fn draw(game: ref Game)
  // We clear the screen before
  // drawing everything
  cls(0)
  
  // Finished state: We draw how many
  // balls have been used to finish
  // the game
  if game.state == 2
    prints("YOU WON!", (160 - 8 * 4) / 2, (144 - 6) / 2, 3)
    prints("BALLS: ", (160 - 9 * 4) / 2, (144 - 6) / 2 + 8, 3)
    if game.balls < 10
      printi(game.balls, (160 - 9 * 4) / 2 + 8 * 4, (144 - 6) / 2 + 8, 3)
      printi(0, (160 - 9 * 4) / 2 + 7 * 4, (144 - 6) / 2 + 8, 3)
    else if game.balls < 100
      printi(game.balls, (160 - 9 * 4) / 2 + 7 * 4, (144 - 6) / 2 + 8, 3)
    else
      prints("+99", (160 - 9 * 4) / 2 + 6 * 4, (144 - 6) / 2 + 8, 3)
    end
  // We draw the same in both starting
  // and playing states
  else
    // Draw the player
    player = ref game.player
    spr(2, player.x, player.y)
    spr(3, player.x + 8, player.y)
    
    // Draw the ball
    ball = ref game.ball
    circ(ftoi(ball.x), ftoi(ball.y), 1, 3)
    
    // Draw the bricks
    for _, ref brick in game.bricks
      if brick.dead
        continue
      end
      
      spr(0, brick.x, brick.y)
      spr(1, brick.x + 8, brick.y)
    end
  end
end

