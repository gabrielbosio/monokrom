use crate::compiler::ast::*;
use crate::compiler::lexer::{Token, LexicalError};

grammar;

extern {
    type Location = usize;
    type Error = LexicalError;

    enum Token {
        "fn" => Token::Fn,
        "if" => Token::If,
        "else" => Token::Else,
        "while" => Token::While,
        "for" => Token::For,
        "in" => Token::In,
        "end" => Token::End,
        "return" => Token::Return,
        "struct" => Token::Struct,
        "true" => Token::True,
        "false" => Token::False,
        "and" => Token::And,
        "or" => Token::Or,
        "not" => Token::Not,
        "break" => Token::Break,
        "continue" => Token::Continue,
        "ref" => Token::Ref,
        "array" => Token::Array,
        "of" => Token::Of,
        "int" => Token::Int,
        "fixed" => Token::Fixed,
        "bool" => Token::Bool,
        "str" => Token::Str,
        "void" => Token::Void,
        "PI" => Token::Pi,
        "E" => Token::Euler,
        INT => Token::IntLit(<i16>),
        FIXED => Token::FixedLit(<String>),
        STRING => Token::StrLit(<String>),
        IDENT => Token::Ident(<String>),
        "==" => Token::Eq,
        "!=" => Token::Neq,
        "<=" => Token::Leq,
        ">=" => Token::Geq,
        "+" => Token::Plus,
        "-" => Token::Minus,
        "*" => Token::Star,
        "/" => Token::Slash,
        "%" => Token::Percent,
        "=" => Token::Assign,
        "<" => Token::Lt,
        ">" => Token::Gt,
        "(" => Token::LParen,
        ")" => Token::RParen,
        "[" => Token::LBracket,
        "]" => Token::RBracket,
        "," => Token::Comma,
        ":" => Token::Colon,
        "..=" => Token::DotDotEq,
        ".." => Token::DotDot,
        "." => Token::Dot,
        NL => Token::Newline,
    }
}

// --- Helpers ---

NL1: () = NL+ => ();

Comma<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        Some(e) => { v.push(e); v }
        None => v,
    }
};

// --- Top-level ---

pub Module: Module = {
    <items:(<TopLevel> NL1)*> <last:TopLevel?> => {
        let mut items = items;
        if let Some(l) = last {
            items.push(l);
        }
        Module { items }
    }
};

TopLevel: TopLevel = {
    FuncDef => TopLevel::Function(<>),
    StructDef => TopLevel::Struct(<>),
    Stmt => TopLevel::Global(<>),
};

// --- Definitions ---

FuncDef: FuncDef = {
    "fn" <name:IDENT> "(" <params:Comma<Param>> ")" <ret:(":" <Type>)?> NL1 <body:Body> "end" => {
        FuncDef { name, params, ret_type: ret, body }
    }
};

Param: Param = {
    <name:IDENT> ":" <ty:Type> => Param { name, ty }
};

StructDef: StructDef = {
    "struct" <name:IDENT> NL1 <fields:(<FieldDef> NL1)*> "end" => {
        StructDef { name, fields }
    }
};

FieldDef: Field = {
    <name:IDENT> ":" <ty:Type> => Field { name, ty }
};

Type: TypeExpr = {
    "int" => TypeExpr::Int,
    "fixed" => TypeExpr::Fixed,
    "bool" => TypeExpr::Bool,
    "str" => TypeExpr::Str,
    "void" => TypeExpr::Void,
    "ref" <ty:Type> => TypeExpr::Ref(Box::new(ty)),
    "array" "[" <size:INT> "]" "of" <ty:Type> => TypeExpr::Array(Box::new(ty), size),
    <name:IDENT> => TypeExpr::Named(name),
};

// --- Statements ---

Body: Vec<Stmt> = {
    <stmts:(<Stmt> NL1)*> => stmts,
};

Stmt: Stmt = {
    <l:@L> <name:IDENT> ":" <ty:Type> "=" <value:Expr> <r:@R> =>
        Stmt::new(StmtKind::VarDecl { name, ty, value: Some(value) }, (l, r)),
    <l:@L> <name:IDENT> ":" <ty:Type> <r:@R> =>
        Stmt::new(StmtKind::VarDecl { name, ty, value: None }, (l, r)),
    <l:@L> <target:PostfixExpr> "=" <value:Expr> <r:@R> =>
        Stmt::new(StmtKind::Assign { target, value }, (l, r)),
    IfStmt,
    WhileStmt,
    ForStmt,
    <l:@L> "return" <e:Expr?> <r:@R> => Stmt::new(StmtKind::Return(e), (l, r)),
    <l:@L> "break" <r:@R> => Stmt::new(StmtKind::Break, (l, r)),
    <l:@L> "continue" <r:@R> => Stmt::new(StmtKind::Continue, (l, r)),
    <l:@L> <e:Expr> <r:@R> => Stmt::new(StmtKind::Expression(e), (l, r)),
};

IfStmt: Stmt = {
    <l:@L> "if" <cond:Expr> NL1
        <body:Body>
        <else_ifs:("else" "if" <Expr> NL1 <Body>)*>
        <else_body:("else" NL1 <Body>)?>
    "end" <r:@R> => {
        Stmt::new(StmtKind::If {
            cond,
            body,
            else_ifs,
            else_body: else_body.unwrap_or_default(),
        }, (l, r))
    }
};

WhileStmt: Stmt = {
    <l:@L> "while" <cond:Expr> NL1
        <body:Body>
    "end" <r:@R> => {
        Stmt::new(StmtKind::While { cond, body }, (l, r))
    }
};

ForStmt: Stmt = {
    <l:@L> "for" <index:IDENT> "," <elem:IDENT> "in" <iter:Expr> NL1
        <body:Body>
    "end" <r:@R> => {
        Stmt::new(StmtKind::ForIn { index, elem, iter, body }, (l, r))
    },
    <l:@L> "for" <var:IDENT> "in" <start:Expr> ".." <end:Expr> NL1
        <body:Body>
    "end" <r:@R> => {
        Stmt::new(StmtKind::ForRange { var, start, end, inclusive: false, body }, (l, r))
    },
    <l:@L> "for" <var:IDENT> "in" <start:Expr> "..=" <end:Expr> NL1
        <body:Body>
    "end" <r:@R> => {
        Stmt::new(StmtKind::ForRange { var, start, end, inclusive: true, body }, (l, r))
    },
};

// --- Expressions (tiered precedence, lowest to highest) ---

Expr: Expr = OrExpr;

OrExpr: Expr = {
    <l:@L> <lhs:OrExpr> "or" <rhs:AndExpr> <r:@R> => Expr::new(ExprKind::BinOp {
        op: BinOp::Or, lhs: Box::new(lhs), rhs: Box::new(rhs)
    }, (l, r)),
    AndExpr,
};

AndExpr: Expr = {
    <l:@L> <lhs:AndExpr> "and" <rhs:CmpExpr> <r:@R> => Expr::new(ExprKind::BinOp {
        op: BinOp::And, lhs: Box::new(lhs), rhs: Box::new(rhs)
    }, (l, r)),
    CmpExpr,
};

CmpExpr: Expr = {
    <l:@L> <lhs:AddExpr> <op:CmpOp> <rhs:AddExpr> <r:@R> => Expr::new(ExprKind::BinOp {
        op, lhs: Box::new(lhs), rhs: Box::new(rhs)
    }, (l, r)),
    AddExpr,
};

CmpOp: BinOp = {
    "==" => BinOp::Eq,
    "!=" => BinOp::Neq,
    "<" => BinOp::Lt,
    ">" => BinOp::Gt,
    "<=" => BinOp::Leq,
    ">=" => BinOp::Geq,
};

AddExpr: Expr = {
    <l:@L> <lhs:AddExpr> "+" <rhs:MulExpr> <r:@R> => Expr::new(ExprKind::BinOp {
        op: BinOp::Add, lhs: Box::new(lhs), rhs: Box::new(rhs)
    }, (l, r)),
    <l:@L> <lhs:AddExpr> "-" <rhs:MulExpr> <r:@R> => Expr::new(ExprKind::BinOp {
        op: BinOp::Sub, lhs: Box::new(lhs), rhs: Box::new(rhs)
    }, (l, r)),
    MulExpr,
};

MulExpr: Expr = {
    <l:@L> <lhs:MulExpr> "*" <rhs:UnaryExpr> <r:@R> => Expr::new(ExprKind::BinOp {
        op: BinOp::Mul, lhs: Box::new(lhs), rhs: Box::new(rhs)
    }, (l, r)),
    <l:@L> <lhs:MulExpr> "/" <rhs:UnaryExpr> <r:@R> => Expr::new(ExprKind::BinOp {
        op: BinOp::Div, lhs: Box::new(lhs), rhs: Box::new(rhs)
    }, (l, r)),
    <l:@L> <lhs:MulExpr> "%" <rhs:UnaryExpr> <r:@R> => Expr::new(ExprKind::BinOp {
        op: BinOp::Mod, lhs: Box::new(lhs), rhs: Box::new(rhs)
    }, (l, r)),
    UnaryExpr,
};

UnaryExpr: Expr = {
    <l:@L> "-" <e:UnaryExpr> <r:@R> => Expr::new(ExprKind::UnaryOp {
        op: UnaryOp::Neg, expr: Box::new(e)
    }, (l, r)),
    <l:@L> "not" <e:UnaryExpr> <r:@R> => Expr::new(ExprKind::UnaryOp {
        op: UnaryOp::Not, expr: Box::new(e)
    }, (l, r)),
    <l:@L> "ref" <e:PostfixExpr> <r:@R> => Expr::new(ExprKind::Ref(Box::new(e)), (l, r)),
    PostfixExpr,
};

PostfixExpr: Expr = {
    <l:@L> <f:PostfixExpr> "(" <args:Comma<Expr>> ")" <r:@R> => Expr::new(ExprKind::Call {
        func: Box::new(f), args
    }, (l, r)),
    <l:@L> <e:PostfixExpr> "[" <i:Expr> "]" <r:@R> => Expr::new(ExprKind::Index {
        expr: Box::new(e), index: Box::new(i)
    }, (l, r)),
    <l:@L> <e:PostfixExpr> "." <field:IDENT> <r:@R> => Expr::new(ExprKind::FieldAccess {
        expr: Box::new(e), field
    }, (l, r)),
    AtomExpr,
};

AtomExpr: Expr = {
    <l:@L> <n:INT> <r:@R> => Expr::new(ExprKind::IntLit(n), (l, r)),
    <l:@L> <f:FIXED> <r:@R> => Expr::new(ExprKind::FixedLit(f), (l, r)),
    <l:@L> "true" <r:@R> => Expr::new(ExprKind::BoolLit(true), (l, r)),
    <l:@L> "false" <r:@R> => Expr::new(ExprKind::BoolLit(false), (l, r)),
    <l:@L> <s:STRING> <r:@R> => Expr::new(ExprKind::StrLit(s), (l, r)),
    <l:@L> "PI" <r:@R> => Expr::new(ExprKind::FixedLit("3.14159265".to_string()), (l, r)),
    <l:@L> "E" <r:@R> => Expr::new(ExprKind::FixedLit("2.71828182".to_string()), (l, r)),
    <l:@L> <name:IDENT> <r:@R> => Expr::new(ExprKind::Ident(name), (l, r)),
    "(" <Expr> ")",
};
